# CivicOps Mumbai: copy to .env.local and fill in what you need. Everything has a working local default.

# Database. Leave DATABASE_URL empty to use the bundled local PGlite database in .data/pgdata.
# Set it to use hosted PostgreSQL 15+ (then run `npm run db:import` against it).
DATABASE_URL=
PGLITE_DIR=

# Private photo storage (local folder outside /public). Swap the driver in src/lib/evidence.ts for S3/R2.
STORAGE_DIR=

# Claude Vision evidence review (server-side only). Without a key the review screen falls back to manual review.
ANTHROPIC_API_KEY=
CLAUDE_VISION_MODEL=claude-opus-5-5
CLAUDE_VISION_EFFORT=medium

# SLA scheduler. The server sweeps every minute in-process; set SCHEDULER_INPROCESS=0 and use
# `npm run scheduler` or a cron job calling POST /api/cron/sla with this secret instead.
CRON_SECRET=change-me
SCHEDULER_INPROCESS=1
# Allow ?now=ISO-time on /api/cron/sla to simulate a controlled clock (demos and tests only).
ALLOW_CLOCK_OVERRIDE=0

# Demo: show one-click demo accounts on the sign-in page. Set to 0 for any real deployment.
DEMO_MODE=1
